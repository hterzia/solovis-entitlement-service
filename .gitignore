# Secrets — never committed
.env

# Vendored read-only reference checkout (LangChain4j examples); not part of the build
refs/

# Agent worktrees — complete additional clones of this repository (~292 MB, each
# with its own .git). Previously excluded only via .git/info/exclude, which is
# local and does not travel with a clone.
.claude/worktrees/

# Build output
**/target/
**/node_modules/
**/dist/

# Local SQLite databases
*.db
*.db-shm
*.db-wal

# Generated walkthrough of the v1 service. A point-in-time snapshot, not a
# maintained document: the copy written on 2026-08-09 still described the client
# SDK as a stub four hours after the SDK merged, and its test counts drift with
# every commit. Kept local so it cannot go stale in the repository — regenerate
# it when you need it rather than trusting a checked-in copy.
docs/entitlement-service-explained.html
